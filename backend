// Actualizar una receta
app.put('/recetas/:id', (req, res) => {
  const { id } = req.params;
  const { nombre, instrucciones, tiempo_preparacion, dificultad, categoría } = req.body;
  const query = 'UPDATE Recetas SET nombre = ?, instrucciones = ?, tiempo_preparacion = ?, dificultad = ?, categoría = ? WHERE receta_id = ?';

  connection.query(query, [nombre, instrucciones, tiempo_preparacion, dificultad, categoría, id], (err, result) => {
    if (err) {
      console.error('Error al actualizar la receta:', err);
      res.status(500).send('Error en el servidor');
      return;
    }
    res.json({ message: 'Receta actualizada exitosamente' });
  });
});

